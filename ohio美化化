-- 储存生成的模型，方便一键清理，防止游戏崩坏
local spawnedModels = {}

local Players = game:GetService("Players")
local plr = Players.LocalPlayer
local char = plr.Character or plr.CharacterAdded:Wait()
local hrp = char:WaitForChild("HumanoidRootPart")

-- 角色刷新自动更新引用
plr.CharacterAdded:Connect(function(newChar)
    task.wait(0.5)
    char = newChar
    hrp = char:WaitForChild("HumanoidRootPart")
end)

-- 生成模型通用函数
local function SpawnVisualModel(assetId, name)
    if not hrp then return end
    local success, model = pcall(function()
        return game:GetObjects("rbxassetid://"..assetId)[1]
    end)
    if not success or not model then
        WindUI:Notify({Title="加载失败", Content="模型资源无法获取", Duration=2})
        return
    end
    model.Name = name
    model.Parent = workspace
    model:SetPrimaryPartCFrame(hrp.CFrame * CFrame.new(0,3,0))
    table.insert(spawnedModels, model)
    WindUI:Notify({Title="生成成功", Content=name.." 本地视觉生成完成", Duration=2})
end

