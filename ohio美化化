    Callback = function()
        local count = 0
        for _,m in ipairs(spawnedModels) do
            if m and m:IsDescendantOf(workspace) then
                m:Destroy()
                count +=1
            end
        end
        table.clear(spawnedModels)
        WindUI:Notify({Title="清理完成", Content="已删除"..count.."个本地模型", Duration=2})
    end
})

-- 全枪皮【本地视觉替换贴图，仅客户端生效】
local gunSkinEnabled = false
gunTab:AddToggle({
    Title = "全枪械皮肤(本地)",
    Description = "仅本地修改枪械贴图，别人看不到，不会改变服务器武器",
    Default = false,
    Callback = function(state)
        gunSkinEnabled = state
        if state then
            WindUI:Notify({Title="开启", Content="本地枪皮渲染已启动", Duration=2})
        else
            WindUI:Notify({Title="关闭", Content="本地枪皮渲染关闭", Duration=2})
        end
    end
})

-- 循环更新枪皮
task.spawn(function()
    while task.wait(0.8) do
        if not gunSkinEnabled then continue end
        for _,desc in ipairs(workspace:GetDescendants()) do
            if desc:IsA("MeshPart") and desc.Name:lower():find("gun") or desc.Name:lower():find("weapon") then
                local success = pcall(function()
                    desc.Texture = "rbxassetid://10887472311"
                end)
            end
        end
    end
end)